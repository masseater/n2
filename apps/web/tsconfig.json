{
  "extends": "@n2/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client", "@cloudflare/workers-types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "drizzle.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".output"]
}
